{
  "hosting": {
    "site": "management-bujm-dashboard",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/node_modules/**",
      "GSPN_Playwright_RPA/**",
      "Auto_Scraper/**",
      "JARVIS_WA_Blaster_Release/**",
      "yes/**",
      "JARVIS_Portable_Cabang_Final/**",
      "**/*.zip",
      "**/*.bat",
      "**/*.exe"
    ],
    "rewrites": [
      {
        "source": "/prime",
        "destination": "/prime.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
